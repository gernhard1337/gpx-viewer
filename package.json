{
	"name": "gpx-viewer",
	"version": "1.0.0",
	"description": "Obsidian plugin to visualize .gpx track files on a Leaflet map.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "MIT",
	"dependencies": {
		"chart.js": "^4.5.1",
		"leaflet": "^1.9.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	}
}
